            "ThinSlippage": 0.625
          }
        },
        {
          "Passed": true,
          "Name": "Unfilled market remainder cancelled, self trades prevented",
          "Detail": "IOC accounting and self-trade prevention passed"
        },
        {
          "Passed": true,
          "Name": "Stop cascade, partial protection, retry and OCO",
          "Detail": "Stop remains latched through insufficient liquidity, never reverses"
        },
        {
          "Passed": true,
          "Name": "Take-profit long and short, entry averaging and realized P&L",
          "Detail": "Both take-profit directions settle from real fills"
        },
        {
          "Passed": true,
          "Name": "Dragged SL and TP amend atomically and trigger from subsequent executions",
          "Detail": "Long/short SL and TP, profitable stops, snapshots, OCO and fill-based exits passed"
        },
        {
          "Passed": true,
          "Name": "Protection edits reject invalid, stale, foreign and out-of-band requests",
          "Detail": "Invalid ticks, direction, ownership, stale versions, price band, cancelled/triggered orders rejected"
        },
        {
          "Passed": true,
          "Name": "Validation, reserved margin, finite inventory and off-tick prices",
          "Detail": "Working orders reserve capacity; invalid inputs rejected"
        },
        {
          "Passed": true,
          "Name": "Every candle timeframe agrees with the execution tape",
          "Detail": "OHLCV independently reconstructed for 1m, 5m, 15m, 1h and 1D"
        },
        {
          "Passed": true,
          "Name": "Seeded participants and identical step-indexed player actions reproduce",
