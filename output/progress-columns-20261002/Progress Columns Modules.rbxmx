<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><Item class="Folder" referent="RBXFolder0"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBXProgressView"><Properties><string name="Name">ProgressView</string><ProtectedString name="Source">-- Stable achievement columns: one ladder per metric, one remembered scroll surface.
local TextService=game:GetService("TextService")
local TweenService=game:GetService("TweenService")
local Art=require(script.Parent.BadgeArt)
local Config=require(script.Parent.ProgressionConfig)
local View={}
local F=Enum.Font.FredokaOne
local C={Text=Color3.fromRGB(245,248,255),Muted=Color3.fromRGB(188,211,247),Surface=Color3.fromRGB(6,30,74),
 Edge=Color3.fromRGB(46,89,152),Gold=Color3.fromRGB(255,216,74),Cyan=Color3.fromRGB(76,223,255),Purple=Color3.fromRGB(178,126,255),Green=Color3.fromRGB(75,240,174)}
local function make(class,name,parent,props)
 local o=Instance.new(class);o.Name=name;for k,v in pairs(props)do o[k]=v end;o.Parent=parent;return o
end
local function box(p,name,x,y,w,h,color)
 return make("Frame",name,p,{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundColor3=color or C.Surface,BorderSizePixel=0})
end
local function round(p,r)make("UICorner","Corners",p,{CornerRadius=UDim.new(0,r)})end
local function card(p,name,x,y,w,h,edge)
 local o=box(p,name,x,y,w,h);round(o,14)
 make("UIStroke","Border",o,{Color=edge or C.Edge,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
 return o
end
local function label(p,name,value,x,y,w,h,size,color)
 return make("TextLabel",name,p,{Text=value,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1,
 TextColor3=color or C.Text,TextSize=size,Font=F,TextStrokeColor3=Color3.fromRGB(1,15,49),TextStrokeTransparency=.65,
 TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=true})
end
local function height(value,size,w)return math.ceil(TextService:GetTextSize(value,size,F,Vector2.new(math.max(1,w-2),10000)).Y)+6 end
local function copy(p,name,value,x,y,w,size,color)
 local h=height(value,size,w);label(p,name,value,x,y,w,h,size,color);return h
end
local function bar(p,name,x,y,w,ratio)
 local track=box(p,name,x,y,w,7,Color3.fromRGB(27,53,96));round(track,4)
 ratio=math.clamp(ratio,0,1);track:SetAttribute("Progress",ratio)
 local fill=box(track,"Fill",0,0,w*ratio,7,C.Cyan);round(fill,4);fill.Visible=ratio&gt;0
end
local function hover(p,icon)
 local base=p.Border.Color
 local function active(on)
  TweenService:Create(p.Border,TweenInfo.new(.13),{Color=on and C.Cyan or base,Thickness=on and 2.5 or 1.5}):Play()
  if icon then TweenService:Create(icon,TweenInfo.new(.13),{Rotation=on and -3 or 0}):Play()end
 end
 p.MouseEnter:Connect(function()active(true)end);p.MouseLeave:Connect(function()active(false)end)
end
local function amount(m,whole)
 return m.Kind=="Profit" and whole(m.Progress or 0).." / "..whole(m.Goal) or tostring(math.floor(m.Progress or 0)).." / "..tostring(m.Goal)
end
function View.Build(parent,pf,x,y,w,h,options)
 local state=options.State or {};local whole=options.Whole;local compact=w&lt;650
 local root=make("ScrollingFrame","Progress",parent,{Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h),
  BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=C.Cyan,ScrollingDirection=Enum.ScrollingDirection.Y,CanvasSize=UDim2.new()})
 local cw=w-24;local gap=12
 local content=box(root,"Content",8,8,cw,1);content.BackgroundTransparency=1
 state.Scroll=state.Scroll or {}
 local draw;local drawing=false;local scrollKey
 root:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
  if scrollKey and not drawing then state.Scroll[scrollKey]=root.CanvasPosition.Y end
 end)
 draw=function()
  drawing=true
  content:ClearAllChildren();local yy=0
  label(content,"Title","Your Progress",0,yy,cw,40,compact and 27 or 34)
  yy=44;yy+=copy(content,"Subtitle","Ranks mark your journey. Titles celebrate your achievements. Both stay yours.",0,yy,cw,14,C.Muted)+12
  if pf.New or not pf.RankId then
   yy+=copy(content,"Loading","Your progression is loading…",0,yy,cw,18,C.Muted)
   content.Size=UDim2.fromOffset(cw,yy);root.CanvasSize=UDim2.fromOffset(0,yy+16);drawing=false;return
  end
  local heroW=compact and cw or math.floor((cw-gap)*.48)
  local heroH=compact and 158 or 216
  local hero=card(content,"CurrentRank",0,yy,heroW,heroH,C.Purple)
  make("UIGradient","Glow",hero,{Color=ColorSequence.new(Color3.fromRGB(105,58,186),Color3.fromRGB(22,35,82)),Rotation=65})
  hero.BackgroundColor3=Color3.new(1,1,1)
  local badgeSize=compact and 70 or 92;local tx=badgeSize+22;local tw=heroW-tx-12
  Art.Create(hero,"RankBadge",pf.RankBadge,10,20,badgeSize)
  label(hero,"RankCaption","PERMANENT RANK "..tostring(pf.RankLevel).." / "..#Config.Ranks,tx,12,tw,20,12,C.Gold)
  local ry=36;ry+=copy(hero,"Rank",pf.Rank,tx,ry,tw,compact and 20 or 25)+4
  label(hero,"TitleCaption","FEATURED TITLE",tx,ry,tw,18,12,C.Muted);ry+=20
  copy(hero,"EquippedTitle",pf.Title,tx,ry,tw,16)
  if not compact then
   label(hero,"ResultsLabel",pf.Failed and "ACCOUNT CLOSED · LIFETIME NET PROFIT"or "ACCOUNT ACTIVE · LIFETIME NET PROFIT",14,heroH-58,heroW-28,18,12,C.Muted)
   label(hero,"Results",options.Signed(pf.Earned or 0),14,heroH-37,heroW-28,28,23,C.Green)
  end
  local nx,ny,nw=compact and 0 or heroW+gap,compact and yy+heroH+gap or yy,compact and cw or cw-heroW-gap
  local n=pf.Next;local nTitle=n and n.Title or "Collection complete!"
  local titleHeight=height(nTitle,23,nw-98)
  local desc=n and n.Name or "Every achievement title is yours. Keep building your legacy."
  local descHeight=height(desc,15,nw-28)
  local nextH=math.max(216,56+titleHeight+descHeight+80)
  if not compact then hero.Size=UDim2.fromOffset(heroW,nextH) end
  local nextCard=card(content,"NextMilestone",nx,ny,nw,nextH,C.Gold)
  label(nextCard,"Eyebrow",n and "NEXT TITLE" or "ALL TITLES EARNED",14,12,nw-94,18,12,C.Gold)
  Art.Create(nextCard,"Badge",n and n.Badge or 16,nw-76,12,62)
  label(nextCard,"Reward",nTitle,14,34,nw-98,titleHeight,23)
  local dy=math.max(82,38+titleHeight)
  label(nextCard,"Goal",desc,14,dy,nw-28,descHeight,15,C.Muted)
  local ratio=n and n.Progress/n.Goal or 1
  bar(nextCard,"Track",14,nextH-59,nw-28,ratio)
  label(nextCard,"Amount",n and amount(n,whole)or "All titles earned",14,nextH-46,nw-28,22,14)
  label(nextCard,"Permanent","Closed trades count. Unlocks are permanent.",14,nextH-23,nw-28,18,12,C.Muted)
  yy=ny+nextH+gap
  if pf.Failed and options.Restart then options.Restart(content,0,yy,cw,44);yy+=56 end
  local count=#(pf.Titles or {})
  if (state.EarnedCount and count&gt;state.EarnedCount)or(state.RankId and state.RankId~=pf.RankId)then
   hero.Border.Thickness=4;TweenService:Create(hero.Border,TweenInfo.new(.65),{Thickness=1.5}):Play()
  end
  state.EarnedCount=count;state.RankId=pf.RankId
  local collection=state.Collection or "Titles"
  for i,tab in ipairs({"Titles","Ranks"})do
   local b=make("TextButton","Tab"..tab,content,{Text=tab=="Titles" and "Title collection" or "Rank ladder",Font=F,TextSize=15,TextColor3=C.Text,
    Position=UDim2.fromOffset((i-1)*(cw/2+4),yy),Size=UDim2.fromOffset(cw/2-4,42),BorderSizePixel=0,
    BackgroundColor3=collection==tab and Color3.fromRGB(104,55,189)or C.Surface});round(b,10)
   b.Activated:Connect(function()state.Collection=tab;draw()end)
  end
  yy+=52
  local explanation=collection=="Titles" and "Three paths. Bigger milestones. Each column unlocks from top to bottom." or "Meet every requirement to rank up. Earned ranks never fall after a loss."
  yy+=copy(content,"CollectionHelp",explanation,0,yy,cw,13,C.Muted)+10
  local cols=cw&gt;=1000 and 3 or cw&gt;=620 and 2 or 1
  local function tile(parent,m,px,py,tileW,fixedH,isNext)
   local earned=m.Earned
   local status=earned and "✓ EARNED"or isNext and "→ NEXT"or "◇ LOCKED"
   local title=collection=="Titles" and m.Title or m.Name
   local titleH=height(title,19,tileW-94)
   local description=collection=="Titles" and m.Name or "Complete every requirement:"
   local descH=height(description,14,tileW-28)
   local top=math.max(80,40+titleH);local tileH=fixedH or top+descH+(collection=="Titles" and 62 or 112)
   local tile=card(parent,m.Key or m.Id,px,py,tileW,tileH,earned and C.Green or isNext and C.Gold or C.Edge)
   tile:SetAttribute("Earned",earned==true);tile:SetAttribute("Next",isNext==true)
   local badge=Art.Create(tile,"Badge",m.Badge,10,13,64);hover(tile,badge)
   label(tile,"Status",status,84,10,tileW-98,20,12,earned and C.Green or isNext and C.Gold or C.Muted)
   label(tile,"Reward",title,84,34,tileW-98,titleH,19)
   label(tile,"Goal",description,14,top,tileW-28,descH,14,C.Muted)
   local by=top+descH+9
   if collection=="Titles" then
    bar(tile,"Track",14,by,tileW-28,earned and 1 or m.Progress/m.Goal)
    local value=earned and (m.EarlierGoal and "Earned before goal update" or "Unlocked forever")or amount(m,whole)
    label(tile,"Amount",value,14,by+13,tileW-28,height(value,14,tileW-28),14)
   else
    for j,metric in ipairs({{"Trades",pf.Trades or 0,"trades"},{"Wins",pf.Wins or 0,"profitable trades"},{"Profit",math.max(0,pf.Earned or 0),"net profit"}})do
     local goal=m[metric[1]];local value=math.min(metric[2],goal)
     local text=metric[1]=="Profit" and whole(value).." / "..whole(goal).." net profit" or value.." / "..goal.." "..metric[3]
     label(tile,"Requirement"..j,earned and "✓ "..(metric[1]=="Profit" and whole(goal).." net profit" or goal.." "..(goal==1 and metric[1]=="Trades"and "trade"or metric[3])) or text,14,by+(j-1)*29,tileW-28,21,14)
     bar(tile,"Track"..j,14,by+(j-1)*29+23,tileW-28,earned and 1 or goal==0 and 1 or value/goal)
    end
   end
   return tileH
  end
  if collection=="Titles" then
   local groups={
    {Kind="Trades",Name="Completed trades",Tab="Trades",Color=C.Cyan,Value=tostring(pf.Trades or 0).." completed"},
    {Kind="Wins",Name="Profitable trades",Tab="Wins",Color=C.Green,Value=tostring(pf.Wins or 0).." profitable"},
    {Kind="Profit",Name="Lifetime net profit",Tab="Profit",Color=C.Gold,Value=options.Signed(pf.Earned or 0)},
   }
   for _,g in ipairs(groups)do
    g.Items={};g.Earned=0
    for _,m in ipairs(pf.Milestones or {})do if m.Kind==g.Kind then table.insert(g.Items,m)end end
    table.sort(g.Items,function(a,b)return a.Goal==b.Goal and a.Key&lt;b.Key or a.Goal&lt;b.Goal end)
    for _,m in ipairs(g.Items)do if m.Earned then g.Earned+=1 elseif not g.Next then g.Next=m.Key end end
   end
   cols=cw&gt;=840 and 3 or 1
   if cols==1 then
    state.Track=state.Track or "Trades"
    local tabW=(cw-2*gap)/3
    for i,g in ipairs(groups)do
     local b=make("TextButton","TrackTab"..g.Kind,content,{Text=g.Tab,Font=F,TextSize=14,TextColor3=C.Text,
      Position=UDim2.fromOffset((i-1)*(tabW+gap),yy),Size=UDim2.fromOffset(tabW,36),BorderSizePixel=0,
      BackgroundColor3=state.Track==g.Kind and Color3.fromRGB(104,55,189)or C.Surface});round(b,10)
     b.Activated:Connect(function()state.Track=g.Kind;draw()end)
    end
    yy+=46
   end
   local tileW=(cw-(cols-1)*gap)/cols
   -- A shared height keeps rows aligned even when names or amounts wrap.
   local tileH=0
   for _,m in ipairs(pf.Milestones or {})do
    local top=math.max(80,40+height(m.Title,19,tileW-98))
    local value=m.Earned and (m.EarlierGoal and "Earned before goal update"or "Unlocked forever")or amount(m,whole)
    tileH=math.max(tileH,top+height(m.Name,14,tileW-28)+22+height(value,14,tileW-28)+16)
   end
   local bottom=yy
   for i,g in ipairs(groups)do if cols==3 or state.Track==g.Kind then
    local gx=cols==3 and (i-1)*(tileW+gap)or 0
    local lane=box(content,"Column"..g.Kind,gx,yy,tileW,1);lane.BackgroundTransparency=1
    lane:SetAttribute("Kind",g.Kind);lane:SetAttribute("NextKey",g.Next)
    local header=card(lane,"Header",0,0,tileW,94,g.Color)
    label(header,"Category",g.Name,14,10,tileW-28,24,18,g.Color)
    label(header,"Total",g.Value,14,38,tileW-28,24,18)
    label(header,"Earned",g.Earned.." / "..#g.Items.." titles earned",14,68,tileW-28,18,12,C.Muted)
    local ly=106
    for _,m in ipairs(g.Items)do
     tile(lane,m,0,ly,tileW,tileH,g.Next==m.Key);ly+=tileH+gap
    end
    lane.Size=UDim2.fromOffset(tileW,ly-gap);bottom=math.max(bottom,yy+ly)
   end end
   yy=bottom+4
  else
   local tileW=(cw-(cols-1)*gap)/cols;local rowY,rowMax=yy,0
   for i,m in ipairs(pf.Ranks or {})do
    local col=(i-1)%cols
    if col==0 and i&gt;1 then rowY+=rowMax+gap;rowMax=0 end
    rowMax=math.max(rowMax,tile(content,m,col*(tileW+gap),rowY,tileW,nil,pf.RankNext and pf.RankNext.Id==m.Id))
   end
   yy=rowY+rowMax+16
  end
  if collection=="Titles" and #(pf.Titles or {})&gt;#(pf.Milestones or {}) then yy+=copy(content,"Alumni","Earlier achievements are preserved in your collection.",0,yy,cw,14,C.Muted)end
  -- Alumni titles have no obsolete account-tier labels; they remain permanent.
  if collection=="Titles" then
   local known={};for _,m in ipairs(pf.Milestones or {})do known[m.Title]=true end
   for _,title in ipairs(pf.Titles or {})do if not known[title]then yy+=copy(content,"AlumniTitle","✓ "..title.." · previously earned",0,yy,cw,15,C.Gold)+6 end end
  end
  content.Size=UDim2.fromOffset(cw,yy);root.CanvasSize=UDim2.fromOffset(0,yy+16)
  scrollKey=collection..(collection=="Titles"and cols==1 and (state.Track or "Trades")or "")
  root.CanvasPosition=Vector2.new(0,math.clamp(state.Scroll[scrollKey]or 0,0,math.max(0,yy+16-h)))
  drawing=false
  root:SetAttribute("Collection",collection);root:SetAttribute("Columns",cols)
 end
 draw();return root
end
return View
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXProgressionConfig"><Properties><string name="Name">ProgressionConfig</string><ProtectedString name="Source">-- Permanent progression uses realized trading evidence; grants never count.
return {
 Version=4,ProgressionVersion=1,StartingBalance=10000,MinimumContracts=5,BalancePerContract=1000,MarginUse=0.8,
 ResetLimits={Burst=5,RefillSeconds=720},AccountLimits={MaxExchangeAccounts=20000},
 BadgeAtlas="rbxassetid://114491192679289",BadgeAtlasSize=1024,
 Ranks={
  {Id="Rookie",Name="Market Rookie",Trades=0,Wins=0,Profit=0,Badge=1},
  {Id="Apprentice",Name="Trading Apprentice",Trades=25,Wins=10,Profit=25000,Badge=2},
  {Id="Rising",Name="Rising Trader",Trades=100,Wins=40,Profit=100000,Badge=4},
  {Id="Skilled",Name="Skilled Trader",Trades=250,Wins=100,Profit=250000,Badge=7},
  {Id="Pro",Name="Market Pro",Trades=500,Wins=250,Profit=500000,Badge=11},
  {Id="Master",Name="Market Master",Trades=1000,Wins=500,Profit=1000000,Badge=13},
  {Id="Legend",Name="Trading Legend",Trades=2500,Wins=1250,Profit=2500000,Badge=15},
  {Id="Sovereign",Name="Market Sovereign",Trades=5000,Wins=2500,Profit=5000000,Badge=16},
 },
 Milestones={
  -- IDs are persistent save keys; keep them stable when raising requirements.
  {Id="FirstTrade",Name="Complete 25 trades",Kind="Trades",Goal=25,Title="Opening Bell",Badge=2,OldTitle="Trader"},
  {Id="FirstWin",Name="Close 25 profitable trades",Kind="Wins",Goal=25,Title="Green Spark",Badge=3,OldTitle="First Win"},
  {Id="Trades5",Name="Complete 100 trades",Kind="Trades",Goal=100,Title="Tape Reader",Badge=4},
  {Id="Profit500",Name="Earn $50,000 lifetime net profit",Kind="Profit",Goal=50000,Title="Profit Scout",Badge=5,OldTitle="Rising Trader"},
  {Id="Wins10",Name="Close 100 profitable trades",Kind="Wins",Goal=100,Title="Green Collector",Badge=6},
  {Id="Trades25",Name="Complete 500 trades",Kind="Trades",Goal=500,Title="Market Navigator",Badge=7},
  {Id="Profit2500",Name="Earn $100,000 lifetime net profit",Kind="Profit",Goal=100000,Title="Golden Edge",Badge=8},
  {Id="Balance10K",Name="Earn $250,000 lifetime net profit",Kind="Profit",Goal=250000,Title="Momentum Maker",Badge=9,OldTitle="Skilled Trader"},
  {Id="Trades100",Name="Complete 1,000 trades",Kind="Trades",Goal=1000,Title="Order Veteran",Badge=10},
  {Id="Balance25K",Name="Earn $500,000 lifetime net profit",Kind="Profit",Goal=500000,Title="Market Pro",Badge=11},
  {Id="Wins100",Name="Close 500 profitable trades",Kind="Wins",Goal=500,Title="Profit Ace",Badge=12},
  {Id="Balance50K",Name="Earn $1,000,000 lifetime net profit",Kind="Profit",Goal=1000000,Title="Market Master",Badge=13},
  {Id="Trades500",Name="Complete 5,000 trades",Kind="Trades",Goal=5000,Title="Closing Champion",Badge=14},
  {Id="Balance100K",Name="Earn $2,500,000 lifetime net profit",Kind="Profit",Goal=2500000,Title="Get Funded Legend",Badge=15},
  {Id="Wins500",Name="Close 2,500 profitable trades",Kind="Wins",Goal=2500,Title="Emerald Titan",Badge=14},
  {Id="Profit250K",Name="Earn $5,000,000 lifetime net profit",Kind="Profit",Goal=5000000,Title="Market Sovereign",Badge=16},
 },
}
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBXFolder1"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBXFundedAccounts"><Properties><string name="Name">FundedAccounts</string><ProtectedString name="Source">-- Single-account lifecycle; historical module name keeps place references stable.
-- All grants, archives and rewards share the exchange's fenced checkpoint.
local Funded={} Funded.__index=Funded
local Rules=require(game.ReplicatedStorage.MarketReign.ProgressionRules)
local TradeStats=require(script.Parent.TradeStats)
local Protection=require(game.ReplicatedStorage.MarketReign.TradeProtection)
local function clone(v) if type(v)~="table" then return v end local r={} for k,x in pairs(v) do r[k]=clone(x) end return r end
local function keys(t) local r={} for k in pairs(t or {}) do table.insert(r,k) end table.sort(r) return r end
function Funded.Validate(c)
 assert(c.Version==4 and type(c.StartingBalance)=="number" and c.StartingBalance&gt;0 and c.StartingBalance&lt;math.huge and c.StartingBalance%1==0,"Invalid single-account configuration")
 assert(type(c.MinimumContracts)=="number" and c.MinimumContracts&gt;=1 and c.MinimumContracts&lt;math.huge and c.MinimumContracts%1==0
  and type(c.BalancePerContract)=="number" and c.BalancePerContract&gt;0 and c.BalancePerContract&lt;math.huge,"Invalid contract limit configuration")
 local seen={} for _,m in ipairs(c.Milestones) do assert(not seen[m.Id] and m.Goal&gt;0 and m.Title,"Invalid milestone");seen[m.Id]=true end
end
function Funded.Key(uid) return tostring(uid) end
function Funded:Profile(uid) return self.Engine.Profiles[uid] end
function Funded:_touch(p) p.Revision=(p.Revision or 0)+1 end
function Funded:Owner(uid) local p=self:Profile(uid);return p and p.Account end
function Funded:Usable(a) return a and not (a.Locked or a.Depleted or a.Retired or a.LegacyRetired) end
function Funded:_new(uid)
 local p={V=4,Run=0,Ledger={},Tiers={},Awards={},Titles={},Rank="New Trader",Tutorial="Pending",Revision=1,
  Created=self.Engine.Time,Events={},RunHistory={},Limits={}}
 self.Engine.Profiles[uid]=p return p
end
function Funded:_open(uid,p,balance,source)
 p.Run+=1
 local id="player:"..uid..":single:"..p.Run
 assert(not self.Engine.Accounts[id],"Duplicate run identity")
 local a=self.Engine:AddAccount(id,balance,self.Config.MinimumContracts,self.Config.MarginUse,true)
 a.ProfileId=uid;a.Group="player:"..uid;a.SingleAccount=true;a.Run=p.Run
 p.Account=id;p.Active=id;p.RunStartBalance=balance;p.RunSource=source;p.FailureNotice=nil
 table.insert(p.Ledger,id);self:_touch(p);return a
end
function Funded:CreationAllowed(kind)
 if (self.Capacity and not self.Capacity(kind)) or #self.Engine.AccountOrder&gt;=self.Config.AccountLimits.MaxExchangeAccounts then
  return false,"The exchange is at capacity. Please try again later."
 end
 return true
end
-- Run before the first durable V8 checkpoint, without interleaved client or market steps.
-- Close through Submit so the house counter-entry, cash flow and inventory stay balanced.
function Funded:Migrate(p,uid)
 if p.V==4 then
  assert(p.Account and self.Engine.Accounts[p.Account] and p.Awards and p.Ledger,"Invalid single-account profile")
  self.Engine:ContractLimit(self.Engine.Accounts[p.Account])
  self:Evaluate(uid,true)
  return
 end
 assert((p.V or 1)&lt;4,"Unsupported player profile version")
 local e=self.Engine;local original=clone(p);local ids,seen={},{}
 local function retain(id)
  assert(e.Accounts[id] and e.Accounts[id].Player,"Missing historical player account")
  if not seen[id] then seen[id]=true;table.insert(ids,id) end
 end
 for _,id in ipairs(p.Ledger or {}) do retain(id) end
 local prefix="player:"..uid..":"
 for _,id in ipairs(e.AccountOrder) do if e.Accounts[id].Player and id:sub(1,#prefix)==prefix then retain(id) end end
 local active=(p.Instances or {})[p.Active] or (p.Tiers or {})[p.Active]
 local selected=type(active)=="table" and active.Account or nil
 if not seen[selected] or not self:Usable(e.Accounts[selected]) then
  selected=nil
  for i=#ids,1,-1 do local a=e.Accounts[ids[i]];if self:Usable(a) and not a.Archive then selected=ids[i];break end end
 end
 local evidence={}
 for _,id in ipairs(ids) do
  local a=e.Accounts[id]
  evidence[id]={Base=a.Base,Balance=a.Balance,Realized=a.Realized,Positions=clone(a.Positions),Orders={}}
  for _,orderId in ipairs(keys(a.OpenOrders)) do table.insert(evidence[id].Orders,clone(e.Orders[orderId])) end
  e:CancelAll(id)
  for _,contract in ipairs(keys(a.Positions)) do
   local pos=a.Positions[contract];pos.Stop=nil;pos.Target=nil;pos.Triggered="Single account migration"
   while a.Positions[contract] do
    local held=a.Positions[contract]
    local ok,result=e:Submit(id,{Contract=contract,Direction=-held.Direction,Quantity=math.min(held.Quantity,e.Config.MaxPlayerQuantity),Type="Market",ReduceOnly=true},{})
    assert(ok and result.Filled&gt;0,"Could not settle historical position")
   end
  end
  TradeStats.Reconcile(e,a,os.time());a.Retired=true;a.LegacyRetired=true;a.Locked=true;a.MigrationArchived=true
 end
 local pending={};for _,v in ipairs(e.PendingStops) do if not seen[v.Owner] then table.insert(pending,v) end end;e.PendingStops=pending
 local carry=selected and e.Accounts[selected].Realized or 0
 local balance=selected and self.Config.StartingBalance+carry or (#ids==0 and self.Config.StartingBalance or 0)
 local q=self:_new(uid);q.Ledger=ids;q.LegacyProfile=original
 q.Migration={Version=1,At=e.Time,Selected=selected,CarryProfit=carry,Balance=balance,Accounts=evidence,
  Rule=tostring(self.Config.StartingBalance).." + selected account net result after closing; no combined balances or wallet conversion"}
 q.PlayerName=p.PlayerName;q.DisplayName=p.DisplayName
 q.Awards=clone(original.Awards or {});q.Titles=clone(original.Titles or {})
 for _,tier in ipairs({"F5K","F10K","F25K","F50K","F100K"}) do
  if (original.Tiers or {})[tier] then table.insert(q.Titles,"Legacy "..tier:sub(2).." Trader") end
 end
 if original.Completion then table.insert(q.Titles,"Legacy Top Tier Complete") end
 local a=self:_open(uid,q,balance,"Migration")
 if balance&lt;=0 then a.Locked=true;a.Depleted=true;a.DepletedAt=e.Time end
 -- Carry is capital on the new run. Its profit is already on the old ledger, counted once.
 self:Evaluate(uid,true)
end
function Funded.new(engine,config,market,options)
 Funded.Validate(config);engine.Profiles=engine.Profiles or {}
 local self=setmetatable({Engine=engine,Config=config,Market=market or engine.Config,Capacity=options and options.Capacity},Funded)
 engine.OnFundedClose=nil
 for _,id in ipairs(engine.AccountOrder) do
  local a=engine.Accounts[id];local uid=id:match("^player:([^:]+):")
  if a.Player and uid and not engine.Profiles[uid] then engine.Profiles[uid]={V=1,Tiers={},Ledger={}} end
 end
 for _,uid in ipairs(keys(engine.Profiles)) do self:Migrate(engine.Profiles[uid],uid) end
 engine.OnFundedClose=function(a,row)
  local p=a.ProfileId and self:Profile(a.ProfileId)
  if p and p.Account==a.Id then
   local earned=self:Evaluate(a.ProfileId,nil,true)
   local view=self:View(a.ProfileId);p.Events=p.Events or {}
   table.insert(p.Events,{Kind="TradeClosed",Account=a.Id,TradeId=row.TradeId,Reason=row.Reason,
    Pnl=row.Pnl,Balance=a.Balance,Next=view.Next,Run=p.Run,Rewards=earned})
   while #p.Events&gt;16 do table.remove(p.Events,1) end
   self:_touch(p)
  end
 end
 return self
end
function Funded:Join(uid)
 local p=self:Profile(uid);if not p then self:Start(uid);p=self:Profile(uid) end;return p
end
function Funded:Start(uid)
 if self:Profile(uid) then return true,"Your trading account is ready.",false end
 local ok,reason=self:CreationAllowed("Start");if not ok then return false,reason end
 self:_open(uid,self:_new(uid),self.Config.StartingBalance,"Start")
 self:Evaluate(uid,true)
 return true,"Your $10,000 in-game trading balance is ready.",true
end
-- Only called on a detached checkpoint by the server's owner command. No client action routes here.
-- Remove every historical account as well as the profile so migration cannot resurrect old progress.
function Funded:ResetPlayer(uid)
 local old=self:Profile(uid);assert(old,"No saved player profile")
 local e=self.Engine local ids,removed={},{} local prefix="player:"..uid..":"
 for _,id in ipairs(e.AccountOrder)do
  local a=e.Accounts[id]
  if a.Player and (a.ProfileId==uid or id:sub(1,#prefix)==prefix)then
   removed[id]=true;table.insert(ids,id)
  end
 end
 for _,id in ipairs(old.Ledger)do assert(removed[id],"Profile contains an account owned by another player")end
 assert(removed[old.Account],"Player account is missing")
 local realized,cash=0,0
 for _,id in ipairs(ids)do
  local a=e.Accounts[id];e:CancelAll(id)
  for _,contract in ipairs(keys(a.Positions))do
   local position=a.Positions[contract];position.Stop=nil;position.Target=nil;position.Triggered="Owner reset"
   local ok,fill=e:Submit(id,{Contract=contract,Direction=-position.Direction,Quantity=position.Quantity,Type="Market",ReduceOnly=true},{})
   assert(ok and fill.Filled==position.Quantity and not a.Positions[contract],"Could not settle reset position")
  end
  realized+=a.Realized;cash+=a.CashFlow
 end
 -- Anonymous exchange totals balance the removed ledgers. This is not a player account and stores
 -- no identity, trades, statistics or rewards. Other players and the public market tape stay intact.
 local clearing=e.Accounts["house:reset-clearing"] or e:AddAccount("house:reset-clearing",0,1e9,1,false)
 clearing.House=true;clearing.Balance+=realized;clearing.Realized+=realized;clearing.CashFlow+=cash
 for _,id in ipairs(ids)do e.Accounts[id]=nil end
 for i=#e.AccountOrder,1,-1 do if removed[e.AccountOrder[i]]then table.remove(e.AccountOrder,i)end end
 for i=#e.PendingStops,1,-1 do if removed[e.PendingStops[i].Owner]then table.remove(e.PendingStops,i)end end
 for i=#e.OrderArchive,1,-1 do if removed[e.OrderArchive[i].Owner]then table.remove(e.OrderArchive,i)end end
 local p=self:_new(uid)
 -- Keep only the internal monotonic token: delayed requests from the wiped account must never match.
 p.Run=old.Run;p.PlayerName=old.PlayerName;p.DisplayName=old.DisplayName;p.ProgressionVersion=self.Config.ProgressionVersion
 self:_open(uid,p,self.Config.StartingBalance,"Start");self:Evaluate(uid,true)
 e:Audit()
 return p.Account
end
function Funded:Earned(p)
 local total=0 for _,id in ipairs(p.Ledger) do total+=self.Engine.Accounts[id].Realized end return total
end
function Funded:_counts(p)
 local trades,wins=0,0
 for _,id in ipairs(p.Ledger) do local a=self.Engine.Accounts[id];local s=a.Stats or TradeStats.Reconcile(self.Engine,a,os.time())
  trades+=(s.Trades or 0)+(s.UntrackedTrades or 0);wins+=s.Wins or 0
 end
 return trades,wins
end
function Funded:_metric(p,m,net,trades,wins)
 return Rules.Metric(m,net,trades,wins),m.Goal
end
function Funded:Evaluate(uid,silent,closingTrade)
 local p=self:Profile(uid);if not p then return end
 local a=self.Engine.Accounts[p.Account];assert(a,"Missing single account")
 local migrated=Rules.Normalize(p,self.Engine.Time)
 local net=self:Earned(p);local trades,wins=self:_counts(p)
 p.ProfitHigh=math.max(p.ProfitHigh or 0,net)
 local earned={}
 for _,m in ipairs(self.Config.Milestones)do
  -- Saved high-water profit is authoritative historical evidence for newly introduced titles.
  local value=self:_metric(p,m,migrated and p.ProfitHigh or net,trades,wins)
  if not p.Awards[m.Id] and value+1e-6&gt;=m.Goal then
   p.Awards[m.Id]={At=self.Engine.Time,Net=net,Run=p.Run,Title=m.Title,Goal=m.Goal}
   table.insert(earned,m.Title)
   if not silent and not closingTrade then p.Events=p.Events or {};table.insert(p.Events,{Kind="Milestone",Name=m.Name,Title=m.Title,Id=m.Id})end
   self:_touch(p)
  end
 end
 p.Titles=Rules.Titles(p)
 local previous,index=Rules.Rank(p.RankId);index=index or 1
 p.RankAwards=p.RankAwards or {}
 for i,r in ipairs(self.Config.Ranks)do
  if i&lt;=index or Rules.Qualifies(r,migrated and p.ProfitHigh or net,trades,wins)then
   if not p.RankAwards[r.Id]then p.RankAwards[r.Id]={At=self.Engine.Time,Net=net};self:_touch(p)end
   index=math.max(index,i)
  end
 end
 local rank=self.Config.Ranks[index];p.RankId=rank.Id;p.Rank=rank.Name
 if previous and previous.Id~=rank.Id and not silent and not closingTrade then
  p.Events=p.Events or {};table.insert(p.Events,{Kind="RankUp",Id=rank.Id,Name=rank.Name})
 end
 if migrated then self:_touch(p)end
 if a.Depleted and p.FailureNotice~=p.Run then
  p.FailureNotice=p.Run;p.Events=p.Events or {}
  if not silent then table.insert(p.Events,{Kind="Depleted",Tier=a.Id,Event=tostring(p.Run),Name="Trading account"})end
  self:_touch(p)
 end
 return earned
end
function Funded:_credits(p)
 local state=p.Limits.Reset or {};local c=self.Config.ResetLimits
 return math.min(c.Burst,(state.Tokens or c.Burst)+math.max(0,self.Engine.Time-(state.At or self.Engine.Time))/(c.RefillSeconds*self.Market.SimulationSpeed))
end
function Funded:CanRestart(p)
 local a=self.Engine.Accounts[p.Account]
 return a.Depleted==true and not next(a.Positions) and not next(a.OpenOrders)
end
-- Completed runs are folded into one accounting record. Legacy migration records remain intact.
function Funded:_archiveRun(uid,p,a)
 assert(not next(a.Positions) and not next(a.OpenOrders),"Cannot archive exposure")
 local id="player:"..uid..":single-history";local archive=self.Engine.Accounts[id]
 if not archive then
  archive=self.Engine:AddAccount(id,0,0,0,true);archive.Retired=true;archive.Locked=true;archive.LegacyRetired=true
  archive.Archive={Attempts=0,Blown=0,Breached=0};table.insert(p.Ledger,id)
 end
 archive.Base+=a.Base;archive.Balance+=a.Balance;archive.Realized+=a.Realized;archive.CashFlow+=a.CashFlow
 archive.Archive.Attempts+=1;archive.Archive.Blown+=1
 archive.CompletedTrades=(archive.CompletedTrades or 0)+(a.CompletedTrades or 0);TradeStats.Merge(archive.Stats,a.Stats)
 for _,row in ipairs(a.History) do table.insert(archive.History,clone(row)) end
 table.sort(archive.History,function(x,y)return x.TradeId&gt;y.TradeId end)
 while #archive.History&gt;self.Engine.Config.MaxAccountHistory do table.remove(archive.History) end
 table.insert(p.RunHistory,1,{Run=p.Run,StartBalance=a.Base,FinalBalance=a.Balance,Net=a.Realized,ClosedAt=self.Engine.Time})
 while #p.RunHistory&gt;32 do table.remove(p.RunHistory) end
 self.Engine.Accounts[a.Id]=nil;table.remove(self.Engine.AccountOrder,table.find(self.Engine.AccountOrder,a.Id))
 table.remove(p.Ledger,table.find(p.Ledger,a.Id))
 local pending={};for _,v in ipairs(self.Engine.PendingStops) do if v.Owner~=a.Id then table.insert(pending,v) end end;self.Engine.PendingStops=pending
end
function Funded:Restart(uid,expected)
 local p=self:Profile(uid);if not p then return false,"Wait for your account to load." end
 if expected~=p.Account then return false,"This restart is out of date. Review your current run." end
 if not self:CanRestart(p) then return false,"A free restart is available after equity reaches $0 and all positions close." end
 local credits=self:_credits(p)
 if credits&lt;1 then return false,"Please wait before restarting again. Your history and rewards are safe." end
 local ok,reason=self:CreationAllowed("Restart");if not ok then return false,reason end
 self:_archiveRun(uid,p,self.Engine.Accounts[p.Account]);p.Limits.Reset={Tokens=credits-1,At=self.Engine.Time}
 self:_open(uid,p,self.Config.StartingBalance,"Restart")
 return true,"Fresh start: $10,000 in-game money. Your titles and lifetime results are kept."
end
function Funded:Flag(uid,stage)
 local p=self:Profile(uid);if not p then return false,"Wait for your account." end
 if stage~="TutorialDone" and stage~="TutorialSkipped" then return false,"Unknown tutorial step." end
 p.Tutorial=stage=="TutorialDone" and "Done" or "Skipped";self:_touch(p);return true,"Saved."
end
function Funded:TakeEvents(uid)
 local p=self:Profile(uid);if not p or not p.Events or #p.Events==0 then return nil end
 local events=p.Events;p.Events={};return events
end
function Funded:SetProtectionPreferences(uid,value)
 local p=self:Profile(uid);if not p then return false,"Wait for your account to load." end
 local nextValue=Protection.ValidatePreferences(value)
 if not nextValue then return false,"Enter valid stop-loss and take-profit amounts and switches." end
 if not p.ProtectionPreferences or not Protection.SamePreferences(p.ProtectionPreferences,nextValue)then
  p.ProtectionPreferences=nextValue;self:_touch(p)
 end
 return true,"Trade protection settings saved."
end
function Funded:View(uid)
 local p=self:Profile(uid);if not p then return {New=true,Revision=0} end
 local a=self.Engine.Accounts[p.Account];local sum=self.Engine:Summary(a);local net=self:Earned(p);local trades,wins=self:_counts(p)
 local failed=a.Depleted==true;local closing=next(a.Positions)~=nil or next(a.OpenOrders)~=nil
 local row={Key=a.Id,Name="Trading account",Short="Trading account",State="Active",Usable=not failed,Depleted=failed,Breached=failed,
  Closing=failed and closing,CanRestart=self:CanRestart(p),DepletionEvent=tostring(p.Run),Balance=a.Balance,Equity=sum.Equity,
  Unrealized=sum.Unrealized,Realized=a.Realized,Limit=self.Engine:ContractLimit(a),Size=a.Base,LossLimit=math.max(0,sum.Equity),Positions=sum.Count}
 local v={Revision=p.Revision,Started=true,Active=a.Id,ActiveName="Trading account",ActiveShort="Trading account",ActiveSize=a.Base,
  Run=p.Run,RunProfit=a.Realized,RunStartBalance=p.RunStartBalance,Earned=net,Open=sum.Unrealized,Balance=a.Balance,Equity=sum.Equity,
  ProtectionPreferences=Protection.Preferences(p.ProtectionPreferences),
  Rank=p.Rank,RankId=p.RankId,Trades=trades,Wins=wins,Titles=clone(p.Titles),Awards=clone(p.Awards),Tutorial=p.Tutorial,Accounts={row},CanRestart=row.CanRestart,
  ActiveCount=failed and 0 or 1,UsableCount=failed and 0 or 1,Failed=failed,Milestones={},Migrated=p.Migration~=nil}
 for _,m in ipairs(self.Config.Milestones) do
  local value,goal=self:_metric(p,m,net,trades,wins)
  local r={Key=m.Id,Badge=m.Badge,Name=m.Name,Short=m.Name,Title=m.Title,Kind=m.Kind,Goal=goal,Progress=math.min(value,goal),
   Remaining=math.max(0,goal-value),Earned=p.Awards[m.Id]~=nil,
   EarlierGoal=p.Awards[m.Id]~=nil and p.Awards[m.Id].Goal~=goal}
  table.insert(v.Milestones,r);if not r.Earned and not v.Next then v.Next=clone(r) end
 end
 local rank,index=Rules.Rank(p.RankId)
 v.RankBadge=rank and rank.Badge;v.RankLevel=index;v.RankNext=index and clone(self.Config.Ranks[index+1])
 local _,title=Rules.Titles(p);v.Title=title and title.Title or (#p.Titles&gt;0 and p.Titles[#p.Titles] or "Your story starts here")
 v.TitleId=title and title.Id;v.TitleBadge=title and title.Badge or 1
 v.Ranks={};for _,r in ipairs(self.Config.Ranks)do local item=clone(r);item.Earned=p.RankAwards[r.Id]~=nil;table.insert(v.Ranks,item)end
 v.Completed=v.Next==nil;return v
end
function Funded:Stats(uid)
 local p=self:Profile(uid);if not p then return {Ready=true,New=true,Scopes={}} end
 local all,current=TradeStats.Empty(),TradeStats.Empty()
 for _,id in ipairs(p.Ledger) do TradeStats.Include(all,self.Engine,self.Engine.Accounts[id]) end
 TradeStats.Include(current,self.Engine,self.Engine.Accounts[p.Account])
 return {Ready=true,Started=true,Run=p.Run,RunStartBalance=p.RunStartBalance,Scopes={
  {Key="ALL",Kind="All",Name="Trading history",Short="Trading history",Life=TradeStats.Finish(all),Current=TradeStats.Finish(current)}}}
end
function Funded:StatsKey(uid)
 local p=self:Profile(uid);if not p then return "new" end
 local a=self.Engine.Accounts[p.Account];return p.Revision..":"..a.Revision..":"..tostring(a.Depleted)
end
function Funded.Perform(engine,owner,req)
 local a=engine.Accounts[owner];if not a then return false,"Unknown account." end
 if req.Action=="Place" then return engine:Submit(owner,req)
 elseif req.Action=="AmendProtection" then return engine:AmendProtection(owner,req)
 elseif req.Action=="AmendOrder" then return engine:AmendOrder(owner,req)
 elseif req.Action=="Cancel" then
  if type(req.OrderId)~="number" then return false,"Unknown order." end
  if req.Protection then return engine:CancelProtection(owner,req.OrderId,req.Protection) end
  return engine:Cancel(owner,req.OrderId)
 elseif req.Action=="Close" then
  local p=a.Positions[req.Contract];if not p then return false,"No open position." end
  engine:CancelAll(owner,req.Contract);p.Triggered="Player close";p.Stop=nil;p.Target=nil
  return engine:Submit(owner,{Contract=req.Contract,Direction=-p.Direction,Quantity=math.min(p.Quantity,engine.Config.MaxPlayerQuantity),Type="Market",ReduceOnly=true})
 end
 return false,"Request rejected."
end
function Funded.Describe(result) return result.Filled&gt;0 and string.format("Filled %d @ %.2f",result.Filled,result.Average) or result.Status end
return Funded
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXRankBadgeTests"><Properties><string name="Name">RankBadgeTests</string><ProtectedString name="Source">-- Disposable engines, real executions and in-memory checkpoint/store roundtrips only.
local C=require(game.ReplicatedStorage.MarketReign.MarketConfig)
local L=require(game.ReplicatedStorage.MarketReign.ProgressionConfig)
local Rules=require(game.ReplicatedStorage.MarketReign.ProgressionRules)
local E=require(script.Parent.MarketEngine)
local F=require(script.Parent.FundedAccounts)
local CP=require(script.Parent.WorldCheckpoint)
local P=require(script.Parent.Participants)
local Ranking=require(script.Parent.LeaderboardRanking)
local Service=require(script.Parent.LeaderboardService)
local Tests={}
local function clone(v)if type(v)~="table"then return v end local r={}for k,x in pairs(v)do r[k]=clone(x)end return r end
local function same(a,b)
 assert(type(a)==type(b),"Type differs")
 if type(a)~="table"then assert(a==b,tostring(a).." != "..tostring(b));return end
 for k,v in pairs(a)do same(v,b[k])end;for k in pairs(b)do assert(a[k]~=nil,"Missing "..k)end
end
local function fresh(uid)
 local c=clone(C);c.WarmupSeconds=0;local e=E.new(c,731);local f=F.new(e,L,c)
 if uid then f:Join(uid)end;return e,f
end
local function result(e,id,amount)
 local b=e.Books.BX;b.Last=math.max(24000,math.ceil(math.abs(amount)/(b.Spec.Multiplier*b.Spec.Tick))+100);b.Reference=b.Last;b.Bids={};b.Asks={}
 assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market"}))
 b.Last+=amount/(b.Spec.Multiplier*b.Spec.Tick)
 assert(e:Submit(id,{Contract="BX",Direction=-1,Quantity=1,Type="Market",ReduceOnly=true}))
 e:AdvanceClock(C.StepSeconds)
end
local function restore(e)
 local pop=setmetatable({Engine=e,Config=e.Config,Random=P.RNG.new(731),Agents={}},P)
 local snapshot=CP.Encode(CP.Capture(e,pop));local r=CP.Restore(CP.Decode(snapshot),e.Config)
 return r,F.new(r,L,r.Config)
end
function Tests.Run()
 local rows={};local function test(name,fn)local ok,detail=pcall(fn);table.insert(rows,{Name=name,Passed=ok,Detail=ok and "Passed"or tostring(detail)})end
 test("16 distinct titles and 8 monotonic rank gates share valid atlas cells",function()
  assert(#L.Milestones==16 and #L.Ranks==8);local seen={}
  for _,m in ipairs(L.Milestones)do assert(not seen[m.Title]and m.Badge&gt;=1 and m.Badge&lt;=16);seen[m.Title]=true end
  for i,r in ipairs(L.Ranks)do if i&gt;1 then local p=L.Ranks[i-1];assert(r.Trades&gt;p.Trades and r.Wins&gt;=p.Wins and r.Profit&gt;=p.Profit)end end
 end)
 test("Fresh account has rookie rank; starting cash, open profit and preferences award nothing",function()
  local e,f=fresh("101");local p=f:Profile("101");local v=f:View("101")
  assert(v.RankId=="Rookie"and v.Next.Key=="FirstTrade"and #v.Titles==0)
  assert(f:SetProtectionPreferences("101",{StopOn=true,TargetOn=false,StopDollars=500,TargetDollars=1500}))
  e.Books.BX.Last=24000;assert(e:Submit(p.Account,{Contract="BX",Direction=1,Quantity=1,Type="Market"}));e.Books.BX.Last+=80
  f:Evaluate("101");assert(not next(p.Awards)and p.RankId=="Rookie")
 end)
 test("Every title boundary and every combined rank gate is exact",function()
  for _,m in ipairs(L.Milestones)do
   local net,trades,wins=0,0,0
   if m.Kind=="Profit"then net=m.Goal-.01 elseif m.Kind=="Trades"then trades=m.Goal-1 else wins=m.Goal-1 end
   assert(Rules.Metric(m,net,trades,wins)&lt;m.Goal)
   if m.Kind=="Profit"then net=m.Goal elseif m.Kind=="Trades"then trades=m.Goal else wins=m.Goal end
   assert(Rules.Metric(m,net,trades,wins)==m.Goal)
  end
  for _,r in ipairs(L.Ranks)do
   assert(Rules.Qualifies(r,r.Profit,r.Trades,r.Wins))
   if r.Trades&gt;0 then assert(not Rules.Qualifies(r,r.Profit,r.Trades-1,r.Wins))end
   if r.Wins&gt;0 then assert(not Rules.Qualifies(r,r.Profit,r.Trades,r.Wins-1))end
   if r.Profit&gt;0 then assert(not Rules.Qualifies(r,r.Profit-.01,r.Trades,r.Wins))end
  end
 end)
 test("A quick $10k profit earns no titles or rank; sustained closes unlock the new gates",function()
  local e,f=fresh("101");local p=f:Profile("101")
  for _=1,10 do result(e,p.Account,1000)end
  assert(p.RankId=="Rookie"and not next(p.Awards)and f:Earned(p)==10000)
  for _=11,25 do result(e,p.Account,1000)end
  assert(p.RankId=="Apprentice"and p.Awards.FirstTrade and p.Awards.FirstWin and not p.Awards.Profit500)
  for _=26,100 do result(e,p.Account,1000)end
  assert(p.RankId=="Rising"and p.Awards.Profit500 and p.Awards.Trades5 and p.Awards.Profit2500)
  assert(p.Awards.Profit500.Goal==50000)
  local awards=clone(p.Awards);local ranks=clone(p.RankAwards)
  result(e,p.Account,-500);same(awards,p.Awards);same(ranks,p.RankAwards);assert(p.RankId=="Rising")
  for _=1,4 do f:Evaluate("101")end;same(awards,p.Awards)
  local seen={};for _,t in ipairs(p.Titles)do assert(not seen[t]);seen[t]=true end;e:Audit()
 end)
 test("All ranks and titles earned through 5000 executions survive depletion, restart and rejoin",function()
  local e,f=fresh("101");local p=f:Profile("101")
  for i=1,5000 do result(e,p.Account,i&lt;=2500 and 2000 or 0)end
  assert(p.RankId=="Sovereign"and #p.Titles==16)
  local awards,ranks=clone(p.Awards),clone(p.RankAwards)
  result(e,p.Account,-5010000);assert(f:Restart("101",p.Account))
  assert(f:View("101").RankId=="Sovereign");e,f=restore(e);f:Join("101");p=f:Profile("101")
  same(awards,p.Awards);same(ranks,p.RankAwards);assert(#p.Titles==16 and p.RankId=="Sovereign")
  assert(e.Accounts[p.Account].Balance==10000 and f:Earned(p)==-10000);e:Audit()
 end)
 test("Legacy tier names normalize once; old awards, balances, history and protection remain intact",function()
  local e,f=fresh("101");local p=f:Profile("101");result(e,p.Account,5000)
  p.ProgressionVersion=nil;p.LegacyProgression=nil;p.RankId=nil;p.RankAwards=nil;p.Rank="Skilled Trader"
  p.Titles={"Legacy 5K Trader","10K Trader","Skilled Trader","Legacy Top Tier Complete","First Win"}
  p.Awards.Balance10K={At=123,Title="Skilled Trader",Net=5000};p.ProtectionPreferences={StopOn=false,TargetOn=true,StopDollars=200,TargetDollars=700}
  local account=clone(e.Accounts[p.Account]);local protection=clone(p.ProtectionPreferences)
  f=F.new(e,L,C);p=f:Profile("101");same(account,e.Accounts[p.Account]);same(protection,p.ProtectionPreferences)
  assert(p.Awards.Balance10K.At==123 and table.find(p.Titles,"Founding Trader")and table.find(p.Titles,"Momentum Maker"))
  for _,m in ipairs(f:View("101").Milestones)do if m.Key=="Balance10K"then assert(m.Earned and m.EarlierGoal and m.Goal==250000)end end
  for _,title in ipairs(p.Titles)do assert(not Rules.Obsolete(title))end
  assert(p.LegacyProgression.Titles[1]=="Legacy 5K Trader")
  local before=clone(p);f=F.new(e,L,C);same(before,f:Profile("101"));e,f=restore(e);same(before,f:Profile("101"))
 end)
 test("Server and Global projection preserve cents, ties, eligibility and permanent rank",function()
  local e,f=fresh("101");f:Join("102");f:Join("103")
  for _,uid in ipairs({"101","102"})do result(e,f:Owner(uid),500)end
  local rows=Ranking.Capture(f);assert(#rows==2 and rows[1].UserId==101 and rows[2].UserId==102)
  assert(rows[1].Rank==1 and rows[2].Rank==2 and rows[1].Cents==50000 and rows[1].ProgressionRankId=="Rookie")
  local stored;local store={UpdateAsync=function(_,_,fn)stored=fn(stored);return stored end,GetAsync=function()return stored end}
  local service=Service.new({Store=store,Studio=true,Now=function()return 1000 end})
  service:Queue({WorldId="isolated",Sequence=1,SavedAt=1000,Rows=rows});assert(service:Flush())
  local global=service:Global(Ranking.Row(f,"101"));same(global.Rows,rows);assert(global.Your.Rank==1)
  local server=service:Server(f,{{UserId=101},{UserId=102},{UserId=103}},{UserId=101})
  assert(server.Rows[1].ProgressionRankId==global.Rows[1].ProgressionRankId and server.Your.Rank==1)
 end)
 test("Old and stale leaderboard snapshots retain scores without inventing progression ranks",function()
  local old={Version=1,WorldId="qa",Sequence=1,SavedAt=100,Rows={{UserId=101,Cents=90000,Eligible=true,Rank=1,Tier="10K Trader"}}}
  local service=Service.new({Store={GetAsync=function()return old end},Now=function()return 1000 end})
  local result=service:Global({UserId=101,Cents=90000,Eligible=true})
  assert(result.State=="Stale"and result.Rows[1].Cents==90000 and result.Rows[1].Rank==nil and result.Rows[1].ProgressionRankId==nil)
 end)
 return rows
end
return Tests
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXSingleAccountTests"><Properties><string name="Name">SingleAccountTests</string><ProtectedString name="Source">-- Disposable engines and fake stores only. No production profile or DataStore is accessed.
local C=require(game.ReplicatedStorage.MarketReign.MarketConfig)
local L=require(game.ReplicatedStorage.MarketReign.ProgressionConfig)
local E=require(script.Parent.MarketEngine)
local F=require(script.Parent.FundedAccounts)
local P=require(script.Parent.Participants)
local CP=require(script.Parent.WorldCheckpoint)
local W=require(script.Parent.WorldService)
local TS=require(script.Parent.TradeStats)
local Ranking=require(script.Parent.LeaderboardRanking)
local Replies=require(script.Parent.ReplyBuffer)
local Tests={}
local function clone(v) if type(v)~="table" then return v end local r={} for k,x in pairs(v) do r[k]=clone(x) end return r end
local function same(a,b)
 assert(type(a)==type(b),"Type differs")
 if type(a)~="table" then assert(a==b,tostring(a).." differs from "..tostring(b));return end
 for k,v in pairs(a) do same(v,b[k]) end;for k in pairs(b) do assert(a[k]~=nil,"Missing "..tostring(k)) end
end
local function fresh(uid)
 local c=clone(C);c.WarmupSeconds=0
 local e=E.new(c,712);local f=F.new(e,L,c);if uid then f:Join(uid) end;return e,f
end
local function pop(e)return setmetatable({Engine=e,Config=e.Config,Random=P.RNG.new(712),Agents={}},P)end
local function result(e,id,amount)
 local b=e.Books.BX;b.Last=math.max(24000,math.ceil(math.abs(amount)/(b.Spec.Multiplier*b.Spec.Tick))+100);b.Reference=b.Last;b.Bids={};b.Asks={}
 assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market"}))
 b.Last+=amount/(b.Spec.Multiplier*b.Spec.Tick)
 assert(e:Submit(id,{Contract="BX",Direction=-1,Quantity=1,Type="Market",ReduceOnly=true}))
 e:AdvanceClock(C.StepSeconds);e:Audit()
end
local function restore(e)
 local r,p=CP.Restore(CP.Decode(CP.Encode(CP.Capture(e,pop(e)))),e.Config)
 return r,F.new(r,L,r.Config),p
end
function Tests.Run()
 local rows={};local function test(name,fn)local ok,detail=pcall(fn);table.insert(rows,{Name=name,Passed=ok,Detail=ok and (detail or "Passed") or tostring(detail)})end
 test("Join and Start idempotently give one $10000 account; no wallet or purchases",function()
  local e,f=fresh("101");local id=f:Owner("101");f:Join("101");f:Start("101")
  assert(#f:Profile("101").Ledger==1 and e.Accounts[id].Balance==10000)
  local v=f:View("101");assert(v.Next.Key=="FirstTrade" and not v.Wallet and not v.Copy and #v.Accounts==1)
  assert(F.Purchase==nil and F.Select==nil and F.Mirror==nil and F.Activate==nil)
 end)
 test("Open profit changes equity only; one small close banks profit without a title",function()
  local e,f=fresh("101");local id=f:Owner("101");local b=e.Books.BX;b.Last=24000
  assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market"}));b.Last+=40
  local sum=e:Summary(e.Accounts[id]);assert(sum.Balance==10000 and sum.Unrealized==500 and sum.Equity==10500)
  assert(not next(f:Profile("101").Awards))
  assert(F.Perform(e,id,{Action="Close",Contract="BX"}));assert(e.Accounts[id].Balance==10500)
  local p=f:Profile("101");assert(not next(p.Awards))
  assert(f:View("101").Next.Key=="FirstTrade")
  local events=f:TakeEvents("101");local closing=events[#events]
  assert(closing.Kind=="TradeClosed" and closing.Balance==10500 and #closing.Rewards==0 and closing.Next.Key=="FirstTrade");e:Audit()
 end)
 test("25 break-even closes earn experience without a profitable-trade title",function()
  local e,f=fresh("101");for _=1,25 do result(e,f:Owner("101"),0)end
  assert(f:Profile("101").Awards.FirstTrade and not f:Profile("101").Awards.FirstWin)
 end)
 test("Recovering lost profit never awards the same title again",function()
  local e,f=fresh("101");local id=f:Owner("101");result(e,id,50000);local awards=clone(f:Profile("101").Awards)
  f:TakeEvents("101");result(e,id,-500);result(e,id,500);same(awards,f:Profile("101").Awards)
  for _,ev in ipairs(f:TakeEvents("101")) do assert(ev.Kind~="Milestone") end
 end)
 test("Long-term profit milestone requires lifetime net profit and persists",function()
  local e,f=fresh("101");local id=f:Owner("101");result(e,id,250000)
  assert(f:Profile("101").Awards.Balance10K);result(e,id,-1000)
  assert(f:Profile("101").Awards.Balance10K and table.find(f:View("101").Titles,"Momentum Maker"))
 end)
 test("Starting cash earns no profit titles; every profit goal unlocks at its advertised amount",function()
  local e,f=fresh("101");local id=f:Owner("101");f:Evaluate("101")
  assert(e.Accounts[id].Balance==10000 and not next(f:Profile("101").Awards))
  for _,m in ipairs(L.Milestones) do if m.Kind=="Profit" then
   result(e,id,m.Goal-f:Earned(f:Profile("101"))-12.5)
   assert(not f:Profile("101").Awards[m.Id],"Balance title awarded early")
   result(e,id,12.5);assert(f:Profile("101").Awards[m.Id],"Balance title missing at goal")
  end end
 end)
 test("Existing $5000 single-account saves keep balances and titles; restart uses $10000",function()
  local old=clone(L);old.StartingBalance=5000
  for _,m in ipairs(old.Milestones)do if m.Id=="Balance10K"then m.Goal=5000 end end
  local e=fresh();local f=F.new(e,old,C);f:Join("101");local id=f:Owner("101")
  result(e,id,5000);assert(f:Profile("101").Awards.Balance10K)
  result(e,id,-2500);local awards=clone(f:Profile("101").Awards)
  e,f=restore(e);assert(e.Accounts[id].Balance==7500 and e.Accounts[id].Base==5000)
  same(awards,f:Profile("101").Awards);f:Join("101");assert(e.Accounts[id].Balance==7500)
  result(e,id,-7500);assert(f:Restart("101",id))
  assert(e.Accounts[f:Owner("101")].Balance==10000);same(awards,f:Profile("101").Awards)
 end)
 test("Healthy reset and forged restart token cannot mint funds",function()
  local e,f=fresh("101");local id=f:Owner("101")
  assert(not f:Restart("101",id));assert(not f:Restart("101","player:other:single:1"));assert(e.Accounts[id].Balance==10000)
 end)
 test("Equity zero cancels orders, liquidates and offers free restart",function()
  local e,f=fresh("101");local id=f:Owner("101");local b=e.Books.BX;b.Last=24000
  assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market",StopTicks=1600,TargetTicks=100}))
  assert(e:Submit(id,{Contract="BT",Direction=1,Quantity=1,Type="Limit",Price=C.Contracts.BT.Last-100}))
  b.Last-=800;e:AdvanceClock(C.StepSeconds);f:Evaluate("101")
  local a=e.Accounts[id];assert(a.Depleted and not next(a.Positions) and not next(a.OpenOrders));assert(f:View("101").CanRestart)
  assert(f:Restart("101",id));local nextId=f:Owner("101");assert(nextId~=id and e.Accounts[nextId].Balance==10000)
  assert(not f:Restart("101",id) and not e.Accounts[id]);e:Audit()
 end)
 test("Restart preserves titles, lifetime losses, history and separates current run",function()
  local e,f=fresh("101");local id=f:Owner("101");result(e,id,50000);result(e,id,-60000)
  local awards=clone(f:Profile("101").Awards);assert(f:Restart("101",id))
  same(awards,f:Profile("101").Awards)
  local scope=f:Stats("101").Scopes[1];assert(scope.Life.Net==-10000 and scope.Life.AllTrades==2 and scope.Current.Net==0 and scope.Current.AllTrades==0)
  result(e,f:Owner("101"),5000);assert(not f:Profile("101").Awards.Balance10K,"Restart grant qualified as profit")
  e:Audit()
 end)
 test("Repeated restart budgets survive rejoin and storage; archive stays bounded",function()
  local e,f=fresh("101")
  for _=1,5 do local id=f:Owner("101");result(e,id,-10000);assert(f:Restart("101",id));f:Join("101") end
  local id=f:Owner("101");result(e,id,-10000);assert(not f:Restart("101",id))
  e,f=restore(e);assert(not f:Restart("101",id));assert(#f:Profile("101").Ledger==2)
  e.Time+=L.ResetLimits.RefillSeconds*C.SimulationSpeed;assert(f:Restart("101",id));e:Audit()
 end)
 test("Position size, stop loss, take profit and all current markets work",function()
  for _,market in ipairs(C.ContractOrder) do
   local e,f=fresh("101");local id=f:Owner("101");local b=e.Books[market]
   assert(e:OrderCapacity(e.Accounts[id],market,1)==10)
   assert(not e:Submit(id,{Contract=market,Direction=1,Quantity=11,Type="Market"}))
   assert(e:Submit(id,{Contract=market,Direction=1,Quantity=1,Type="Market",StopTicks=4,TargetTicks=8}))
   local p=e.Accounts[id].Positions[market];assert(p.Stop and p.Target)
   p.Triggered="Take profit";table.insert(e.PendingStops,{Owner=id,Contract=market,Position=p.Id});e:ProcessStops()
   assert(not e.Accounts[id].Positions[market]);assert(e.Accounts[id].Realized&gt;0);e:Audit()
  end
 end)
 test("Current positions, orders, rewards and tutorial survive codec restore exactly",function()
  local e,f=fresh("101");result(e,f:Owner("101"),50000);f:Flag("101","TutorialDone")
  assert(e:Submit(f:Owner("101"),{Contract="BX",Direction=1,Quantity=1,Type="Market",StopTicks=10,TargetTicks=30}))
  assert(e:Submit(f:Owner("101"),{Contract="BT",Direction=-1,Quantity=1,Type="Limit",Price=C.Contracts.BT.Last+100}))
  local before=CP.Capture(e,pop(e));local r,g=restore(e);same(before,CP.Capture(r,pop(r)))
  assert(g:Owner("101")==f:Owner("101"));same(g:View("101"),f:View("101"));r:Audit()
 end)
 test("Legacy migration closes all exposure and carries only selected net profit",function()
  local e=fresh();local first=e:AddAccount("player:101:F5K:1",5000,5,.8,true);first.Tier="F5K"
  local second=e:AddAccount("player:101:F100K:1",100000,100,.8,true);second.Tier="F100K"
  result(e,first.Id,500);result(e,second.Id,2000)
  assert(e:Submit(second.Id,{Contract="BX",Direction=1,Quantity=1,Type="Market"}));e.Books.BX.Last+=40
  assert(e:Submit(first.Id,{Contract="BT",Direction=1,Quantity=1,Type="Limit",Price=C.Contracts.BT.Last-100}))
  e.Profiles={['101']={V=3,Ledger={first.Id,second.Id},Active="F100K:1",Instances={['F100K:1']={Account=second.Id}},
   Tiers={F5K={},F100K={}},Completion={At=1},WalletCents=123456,Purchases={{Sequence=1}},Copy={Enabled=true,Followers={"F5K:1"}}}}
  local before=CP.Capture(e,pop(e));before.Version=7
  local r=CP.Restore(before,C);local f=F.new(r,L,C);local p=f:Profile("101");local a=r.Accounts[p.Account]
  assert(a.Balance==12500 and a.Realized==0 and f:Earned(p)==3000)
  assert(not next(a.Positions) and not next(a.OpenOrders) and p.LegacyProfile.WalletCents==123456)
  assert(p.LegacyProfile.Purchases[1].Sequence==1 and p.Migration.Accounts[first.Id].Orders[1])
  assert(table.find(p.Titles,"Founding Trader") and p.LegacyProfile.Completion);assert(not p.WalletCents and not p.Copy)
  for _,id in ipairs({first.Id,second.Id}) do assert(r.Accounts[id].MigrationArchived and not next(r.Accounts[id].Positions));assert(not r:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market"})) end
  local after=CP.Capture(r,pop(r));local rr=CP.Restore(after,C);same(after,CP.Capture(rr,pop(rr)));r:Audit();rr:Audit()
 end)
 test("Migration loss, orphan accounts, and all-failed legacy profiles are safe",function()
  local e=fresh();local a=e:AddAccount("player:101:F25K:1",25000,25,.8,true);a.Tier="F25K";result(e,a.Id,-11000)
  local f=F.new(e,L,C);assert(e.Accounts[f:Owner("101")].Balance==-1000 and f:View("101").Failed)
  assert(f:Restart("101",f:Owner("101")));assert(f:Earned(f:Profile("101"))==-11000);e:Audit()
  local e2=fresh();local b=e2:AddAccount("player:102:F5K:1",5000,5,.8,true);result(e2,b.Id,-5000)
  local g=F.new(e2,L,C);assert(g:View("102").Failed and g:View("102").CanRestart)
 end)
 test("Migration rejects future profile versions and missing ledgers",function()
  local e,f=fresh("101");local snap=CP.Capture(e,pop(e));snap.Engine.Profiles['101'].V=99
  assert(not pcall(CP.Restore,snap,C));snap=CP.Capture(e,pop(e));table.insert(snap.Engine.Profiles['101'].Ledger,"missing")
  assert(not pcall(CP.Restore,snap,C));snap.Version=999;assert(not pcall(CP.Restore,snap,C))
 end)
 test("Leaderboard counts net lifetime closed profit including failed runs",function()
  local e,f=fresh("101");assert(not Ranking.Row(f,"101").Eligible)
  result(e,f:Owner("101"),500);local row=Ranking.Row(f,"101");assert(row.Eligible and row.Cents==50000 and row.ProgressionRankId=="Rookie")
  result(e,f:Owner("101"),-10500);assert(f:Restart("101",f:Owner("101")));assert(Ranking.Row(f,"101").Cents==-1000000)
 end)
 test("Checkpoint size and corruption fail closed",function()
  local e=fresh("101");local snap=CP.Capture(e,pop(e));assert(not pcall(CP.Encode,snap,100))
  local record=CP.Encode(snap);record.Digest="bad";assert(not pcall(CP.Decode,record))
 end)
 test("Capacity rejects starts and restarts without partial grants",function()
  local e=fresh();local f=F.new(e,L,C,{Capacity=function()return false end});assert(not f:Start("101") and not f:Profile("101"))
  f.Capacity=nil;f:Start("101");local id=f:Owner("101");result(e,id,-10000);f.Capacity=function()return false end
  assert(not f:Restart("101",id) and f:Owner("101")==id);e:Audit()
 end)
 test("Stale order ownership and invalid payloads are rejected by engine",function()
  local e,f=fresh("101");f:Join("102");local id=f:Owner("101")
  local ok,o=e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Limit",Price=C.Contracts.BX.Last-100});assert(ok)
  assert(not e:Cancel(f:Owner("102"),o.Id))
  for _,q in ipairs({0,-1,0.5,math.huge,0/0,1e10}) do assert(not e:Submit(id,{Contract="BX",Direction=1,Quantity=q,Type="Market"})) end
 end)
 test("Tutorial replay flags do not grant funds or rewards",function()
  local e,f=fresh("101");for _=1,3 do f:Flag("101","TutorialDone");f:Flag("101","TutorialSkipped") end
  assert(e.Accounts[f:Owner("101")].Balance==10000 and not next(f:Profile("101").Awards));assert(not f:Flag("101","CopyIntro"))
 end)
 return rows
end
return Tests
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXTradePreferencesTests"><Properties><string name="Name">TradePreferencesTests</string><ProtectedString name="Source">-- Isolated exchange/profile tests, including real fills and encoded checkpoint restart.
local C=require(game.ReplicatedStorage.MarketReign.MarketConfig)
local L=require(game.ReplicatedStorage.MarketReign.ProgressionConfig)
local Protection=require(game.ReplicatedStorage.MarketReign.TradeProtection)
local E=require(script.Parent.MarketEngine)
local F=require(script.Parent.FundedAccounts)
local P=require(script.Parent.Participants)
local CP=require(script.Parent.WorldCheckpoint)
local Tests={}
local function fresh()
 local e=E.new(C,8912);local f=F.new(e,L,C);f:Join("preferences-test")
 local id=f:Owner("preferences-test");local b=e.Books.BX;b.Last=math.round(C.Contracts.BX.Last/b.Spec.Tick)
 return e,f,id
end
local function trade(e,price)
 e:AddAccount("test-maker",1e9,10000,.99,false);e:AddAccount("test-taker",1e9,10000,.99,false)
 assert(e:Submit("test-maker",{Contract="BX",Direction=-1,Quantity=1,Type="Limit",Price=price}))
 assert(e:Submit("test-taker",{Contract="BX",Direction=1,Quantity=1,Type="Limit",Price=price}))
end
local function restore(e)
 local pop=setmetatable({Engine=e,Config=e.Config,Random=P.RNG.new(8912),Agents={}},P)
 local r=CP.Restore(CP.Decode(CP.Encode(CP.Capture(e,pop))),C)
 return r,F.new(r,L,C)
end
function Tests.Run()
 local rows={}
 local function test(name,fn)local ok,err=pcall(fn);table.insert(rows,{Name=name,Passed=ok,Detail=ok and "Passed"or tostring(err)})end
 test("Unsaved profiles keep the existing $500/$1500 enabled defaults",function()
  local _,f=fresh();local v=f:View("preferences-test").ProtectionPreferences
  assert(v.StopOn and v.TargetOn and v.StopDollars==500 and v.TargetDollars==1500)
  assert(f:Profile("preferences-test").ProtectionPreferences==nil)
 end)
 test("Both false switches and disabled amounts survive encoded save, new engine and rejoin",function()
  local e,f=fresh();local prefs={StopOn=false,TargetOn=false,StopDollars=123.45,TargetDollars=678.9}
  assert(f:SetProtectionPreferences("preferences-test",prefs));e,f=restore(e);f:Join("preferences-test")
  assert(Protection.SamePreferences(prefs,f:View("preferences-test").ProtectionPreferences))
  prefs.StopDollars=1;assert(f:Profile("preferences-test").ProtectionPreferences.StopDollars==123.45)
 end)
 test("Invalid or incomplete preferences fail atomically; another profile is unchanged",function()
  local _,f=fresh();f:Join("other")
  local value={StopOn=false,TargetOn=true,StopDollars=123.45,TargetDollars=678.9}
  assert(f:SetProtectionPreferences("preferences-test",value))
  for _,bad in ipairs({0,-1,math.huge,0/0,"12",{}})do
   local r=table.clone(value);r.StopDollars=bad;assert(not f:SetProtectionPreferences("preferences-test",r))
  end
  local r=table.clone(value);r.TargetOn=nil;assert(not f:SetProtectionPreferences("preferences-test",r))
  r=table.clone(value);r.StopOn=0;assert(not f:SetProtectionPreferences("preferences-test",r))
  assert(Protection.SamePreferences(value,f:View("preferences-test").ProtectionPreferences))
  assert(f:View("other").ProtectionPreferences.StopDollars==500)
 end)
 test("Updating defaults never amends an open position or an existing working order",function()
  local e,f,id=fresh()
  assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market",StopDollars=500,TargetDollars=1500}))
  local p=e.Accounts[id].Positions.BX;local stop,target=p.Stop,p.Target
  local ok,r=e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Limit",Price=p.Entry-50,StopDollars=500,TargetDollars=1500});assert(ok)
  local order=e.Orders[r.Id];local stopTicks,targetTicks=order.StopTicks,order.TargetTicks
  assert(f:SetProtectionPreferences("preferences-test",{StopOn=false,TargetOn=true,StopDollars=111,TargetDollars=222}))
  assert(p.Stop==stop and p.Target==target and order.StopTicks==stopTicks and order.TargetTicks==targetTicks)
  assert(F.Perform(e,id,{Action="Close",Contract="BX"}))
  assert(f:View("preferences-test").ProtectionPreferences.StopDollars==111);e:Audit()
 end)
 for _,side in ipairs({1,-1})do for _,reason in ipairs({"Take profit","Stop loss"})do
  test(reason.." on "..(side==1 and "long"or "short").." announces once only after execution",function()
   local e,f,id=fresh()
   assert(e:Submit(id,{Contract="BX",Direction=side,Quantity=1,Type="Market",StopDollars=100,TargetDollars=200}))
   local p=e.Accounts[id].Positions.BX;local price=reason=="Take profit"and p.Target or p.Stop
   assert(not f:TakeEvents("preferences-test"));trade(e,price)
   assert(p.Triggered==reason and not f:TakeEvents("preferences-test"),"A price trigger is not a fill")
   e:ProcessStops();assert(not e.Accounts[id].Positions.BX)
   local events=f:TakeEvents("preferences-test");assert(#events==1,"Close should not add progression toasts")
   local ev=events[1];assert(ev.Kind=="TradeClosed"and ev.Reason==reason and ev.Account==id and ev.TradeId==e.Accounts[id].History[1].TradeId)
   e:ProcessStops();assert(not f:TakeEvents("preferences-test"));e:Audit()
  end)
 end end
 test("Manual close has an execution identity; rejected close emits nothing",function()
  local e,f,id=fresh()
  assert(not F.Perform(e,id,{Action="Close",Contract="BX"}));assert(not f:TakeEvents("preferences-test"))
  for _=1,25 do
   assert(e:Submit(id,{Contract="BX",Direction=1,Quantity=1,Type="Market"}))
   assert(F.Perform(e,id,{Action="Close",Contract="BX"}))
   local events=f:TakeEvents("preferences-test");assert(#events==1 and events[1].Reason=="Player close"and events[1].TradeId)
  end
  assert(f:Profile("preferences-test").Awards.FirstTrade,"Titles still earned without expanding the toast")
 end)
 return rows
end
return Tests
</ProtectedString></Properties></Item></Item></roblox>